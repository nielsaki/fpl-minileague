@page "/"
@page "/gw"
@page "/gw/{Gameweek:int}"
@using System.Globalization
@implements IDisposable
@inject ManagerStore Store
@inject NavigationManager Nav
@inject SiteMode Site

@* One page, two views: Season (standings after the latest gameweek, season totals) and Gameweek
   (standings as they were after a chosen gameweek: totals up to then, with that gameweek's own
   numbers underneath). *@

<PageTitle>@(_gameweekView && _gameweeks.Count > 0 ? $"GW {_selectedGw} · Mini-league" : "Mini-league")</PageTitle>

<LeagueHeader Active="@(_gameweekView ? "gw" : "season")" Description="@Description" GameweekHref="@GameweekHref" />

@foreach (var problem in _snapshot.Problems)
{
    <p class="notice notice-error">@problem</p>
}
@if (_snapshot.Missing.Count > 0)
{
    <p class="notice notice-warn">
        @(_snapshot.Missing.Count == 1 ? "Team" : "Teams") @string.Join(", ", _snapshot.Missing)
        from teams.txt @(_snapshot.Missing.Count == 1 ? "hasn't" : "haven't") been fetched from FPL yet.
    </p>
}

@if (_snapshot.Managers.Count > 0 && _gameweeks.Count == 0)
{
    <section class="panel empty">
        <h3>Waiting for gameweek 1</h3>
        <p>The standings start once the first deadline of the season has passed.</p>
    </section>
}
else if (_snapshot.Managers.Count == 0)
{
    <section class="panel empty">
        <h3>No managers yet</h3>
        <p>
            Add FPL team IDs to <code>teams.txt</code>, one per line. Names, points and history are
            fetched from FPL and kept up to date.
        </p>
    </section>
}
else
{
    @if (_gameweekView)
    {
        var index = IndexOf(_selectedGw);
        var prev = index > 0 ? _gameweeks[index - 1] : (int?)null;
        var next = index < _gameweeks.Count - 1 ? _gameweeks[index + 1] : (int?)null;
        <div class="gw-picker">
            @if (prev is int p)
            {
                <a class="btn btn-ghost" href="gw/@p" aria-label="Previous gameweek">‹</a>
            }
            else
            {
                <span class="btn btn-ghost disabled" aria-hidden="true">‹</span>
            }
            @* data-nav lets the published copy's script follow the choice; locally Blazor does. *@
            <select aria-label="Gameweek" data-nav value="@($"gw/{_selectedGw}")" @onchange="OnGameweekPicked">
                @foreach (var gw in _gameweeks)
                {
                    <option value="gw/@gw" selected="@(gw == _selectedGw)">Gameweek @gw</option>
                }
            </select>
            @if (next is int n)
            {
                <a class="btn btn-ghost" href="gw/@n" aria-label="Next gameweek">›</a>
            }
            else
            {
                <span class="btn btn-ghost disabled" aria-hidden="true">›</span>
            }
        </div>
    }

    <section class="panel">
        <header>
            <h3>
                @(_gameweekView ? $"Standings after gameweek {_selectedGw}" : "Season standings")
                @if (IsLive(_selectedGw))
                {
                    <span class="live-tag" title="FPL hasn't finished this gameweek yet; points can still change">Live</span>
                }
            </h3>
            @if (_gameweekView)
            {
                <span class="muted">
                    Global average:
                    @(_averages.TryGetValue(_selectedGw, out var avg) ? avg.ToString(CultureInfo.InvariantCulture) : "not final yet")
                </span>
            }
            else
            {
                <span class="muted">After gameweek @_selectedGw</span>
            }
        </header>
        <div class="table-scroll">
            <table class="plain board">
                <thead>
                    <tr>
                        <th class="r">#</th>
                        <th>Manager</th>
                        <th class="r">Overall points</th>
                        <th class="r">Behind leader</th>
                        <th class="r" title="Points left on the bench, added up">
                            Bench pain<small>@(_gameweekView ? $"Total to GW {_selectedGw}" : "Season")</small>
                        </th>
                        <th class="r" title="Gameweek points minus the official FPL global average, added up">
                            vs global avg<small>@(_gameweekView ? $"Total to GW {_selectedGw}" : "Season")</small>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in _standings)
                    {
                        <tr class="@(s.Rank is null ? "not-started" : null)">
                            <td class="r rank">@Show(s.Rank)</td>
                            <td class="name">
                                @s.Manager
                                @if (s.TeamName.Length > 0)
                                {
                                    <span class="sub">@s.TeamName</span>
                                }
                            </td>
                            @if (s.OverallPoints is int op)
                            {
                                <td class="r points">
                                    @if (s.OverallPointsGameweek != _selectedGw)
                                    {
                                        <span class="tag" title="@($"FPL has no GW {_selectedGw} row for {s.Manager}, so this is the total after GW {s.OverallPointsGameweek}")">GW @s.OverallPointsGameweek</span>
                                    }
                                    @op.ToString("N0", CultureInfo.InvariantCulture)
                                </td>
                                <td class="r">
                                    @if (s.PointsBehindLeader == 0)
                                    {
                                        <span class="muted">Leader</span>
                                    }
                                    else
                                    {
                                        @Show(s.PointsBehindLeader)
                                    }
                                </td>
                                @if (_gameweekView)
                                {
                                    <td class="r">
                                        @s.BenchPointsToDate
                                        <span class="sub">@Show(s.BenchPoints) in GW @_selectedGw</span>
                                    </td>
                                    <td class="r">
                                        @Diff(SeasonVsAverage(s))
                                        <span class="sub">@Signed(s.VsAverage) in GW @_selectedGw</span>
                                    </td>
                                }
                                else
                                {
                                    <td class="r">@s.BenchPointsToDate</td>
                                    <td class="r">@Diff(SeasonVsAverage(s))</td>
                                }
                            }
                            else
                            {
                                <td class="r muted" colspan="4">No data up to gameweek @_selectedGw</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (!_gameweekView)
    {
        <section class="panel">
            <header>
                <h3>Points vs global average, by gameweek</h3>
                <span class="muted">Gameweek points minus the official FPL average</span>
            </header>
            <div class="table-scroll">
                <table class="plain grid">
                    <thead>
                        <tr>
                            <th class="sticky">Manager</th>
                            @foreach (var gw in _gameweeks)
                            {
                                <th class="r"><a href="gw/@gw">GW @gw</a></th>
                            }
                            <th class="r total">Total</th>
                        </tr>
                        <tr class="avg-row">
                            <td class="sticky">Global average</td>
                            @foreach (var gw in _gameweeks)
                            {
                                @if (_averages.TryGetValue(gw, out var gwAvg))
                                {
                                    <td class="r">@gwAvg</td>
                                }
                                else
                                {
                                    <td class="r" title="FPL hasn't finished this gameweek yet">–</td>
                                }
                            }
                            <td class="total"></td>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _standings)
                        {
                            var manager = _byKey[s.Key];
                            <tr>
                                <td class="name sticky">@s.Manager</td>
                                @foreach (var gw in _gameweeks)
                                {
                                    @if (!manager.Gameweeks.ContainsKey(gw))
                                    {
                                        <td class="r missing" title="@($"FPL has no GW {gw} row for {s.Manager}")">·</td>
                                    }
                                    else
                                    {
                                        <td class="r">@Diff(LeagueStatistics.VsAverage(manager, gw, _averages))</td>
                                    }
                                }
                                <td class="r total">@Diff(SeasonVsAverage(s))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </section>
    }

    <p class="footnote">
        Overall points are FPL's own totals, which already have transfer hits deducted, so hits aren't
        subtracted again. While a gameweek is being played its points are FPL's live totals and can still
        change (bench points catch up when FPL updates its history). A gameweek is compared with the
        global average once FPL marks it finished; a gameweek missing from a manager's history is left
        out, not counted as zero.
    </p>
}

@code {
    [Parameter] public int? Gameweek { get; set; }

    private ManagerStore.Snapshot _snapshot = ManagerStore.Snapshot.Empty;
    private Dictionary<string, ManagerHistory> _byKey = [];
    private IReadOnlyList<int> _gameweeks = [];
    private IReadOnlyDictionary<int, int> _averages = new Dictionary<int, int>();
    private IReadOnlyList<Standing> _standings = [];
    private bool _gameweekView;
    private int _selectedGw;

    private string Description =>
        _gameweeks.Count == 0 ? "Add FPL team IDs to teams.txt."
        : _gameweekView ? $"Gameweek {_selectedGw}{(IsLive(_selectedGw) ? " (in progress)" : "")} · {ManagerCount}"
        : $"Season so far, after gameweek {_selectedGw}{(IsLive(_selectedGw) ? " (in progress)" : "")} · {ManagerCount}";

    private string ManagerCount =>
        _snapshot.Managers.Count == 1 ? "1 manager" : $"{_snapshot.Managers.Count} managers";

    private string GameweekHref =>
        _gameweeks.Count == 0 ? "gw" : $"gw/{(_gameweekView ? _selectedGw : _gameweeks[^1])}";

    protected override void OnInitialized() => Store.Changed += OnStoreChanged;

    protected override void OnParametersSet()
    {
        _gameweekView = Nav.ToBaseRelativePath(Nav.Uri).StartsWith("gw", StringComparison.OrdinalIgnoreCase);
        Refresh();
    }

    private void Refresh()
    {
        var snapshot = Store.Current;
        var gameweeks = LeagueStatistics.Gameweeks(snapshot.Managers);
        _snapshot = snapshot;
        _averages = snapshot.Averages;
        _byKey = snapshot.Managers.ToDictionary(m => m.Key);
        _gameweeks = gameweeks;
        if (gameweeks.Count == 0)
        {
            _standings = [];
            return;
        }

        var latest = gameweeks[^1];
        _selectedGw = _gameweekView ? Math.Clamp(Gameweek ?? latest, gameweeks[0], latest) : latest;
        _standings = LeagueStatistics.Standings(snapshot.Managers, _selectedGw, _averages);
    }

    // teams.txt was edited or new data was fetched from FPL.
    private void OnStoreChanged() => _ = InvokeAsync(() =>
    {
        Refresh();
        StateHasChanged();
    });

    /// <summary>The gameweek is still being played (FPL hasn't marked it finished).</summary>
    private bool IsLive(int gameweek) => _snapshot.Game is { } game && !game.IsFinished(gameweek);

    private void OnGameweekPicked(ChangeEventArgs e) => Nav.NavigateTo($"{e.Value}");

    private int IndexOf(int gameweek) => _gameweeks.Count == 0 ? -1 : gameweek - _gameweeks[0];

    private static int? SeasonVsAverage(Standing s) => s.VsAverageGameweeks > 0 ? s.VsAverageToDate : null;

    private static string Show(int? value) => value?.ToString(CultureInfo.InvariantCulture) ?? "–";

    private static string Signed(int? value) => value switch
    {
        null => "–",
        > 0 => $"+{value}",
        < 0 => $"−{-value}",
        _ => "0",
    };

    private static RenderFragment Diff(int? value) =>
        @<span class="diff @(value switch { > 0 => "pos", < 0 => "neg", _ => "zero" })">@Signed(value)</span>;

    public void Dispose() => Store.Changed -= OnStoreChanged;
}
