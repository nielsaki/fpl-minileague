@page "/managers"
@using System.Globalization
@implements IDisposable
@inject FplEntries Entries
@inject ManagerStore Store

@* Who is in the mini-league: add managers by pasting their FPL links (or import a CSV), see when
   each was last fetched, and remove them. *@

<PageTitle>Managers · Mini-league</PageTitle>

<LeagueHeader Active="managers" Description="@Description" />

@foreach (var message in _messages)
{
    <p class="notice @(message.IsError ? "notice-error" : "notice-ok")" role="status">@message.Text</p>
}
@foreach (var problem in Store.Current.Problems)
{
    <p class="notice notice-error">@problem</p>
}

<section class="panel">
    <header>
        <h3>Add managers</h3>
    </header>
    <form class="add-form" @onsubmit="AddAsync" @onsubmit:preventDefault>
        <input type="text" @bind="_input" @bind:event="oninput" disabled="@_busy" autocomplete="off"
               aria-label="FPL links or team IDs"
               placeholder="https://fantasy.premierleague.com/entry/2985395/history" />
        <button type="submit" class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_input))">
            @(_busy ? "Adding…" : "Add")
        </button>
    </form>
    <p class="hint">
        Paste one or more links to managers' FPL pages, such as their gameweek history or their points page
        from the league table. Team IDs work too. Their data is fetched now, kept on this computer and
        updated from FPL every @((int)FplRefresher.Interval.TotalMinutes) minutes.
    </p>
    <p class="hint">
        Have an exported history instead?
        <label class="link-button">
            Import a CSV
            <InputFile OnChange="ImportAsync" multiple accept=".csv,text/csv" class="visually-hidden" />
        </label>
    </p>
</section>

<section class="panel">
    <header>
        <h3>In the league</h3>
        <span class="muted">@_rows.Count @(_rows.Count == 1 ? "manager" : "managers")</span>
    </header>
    @if (_rows.Count == 0)
    {
        <p class="muted empty-line">No managers yet. Paste their links above.</p>
    }
    else
    {
        <div class="table-scroll">
            <table class="plain managers">
                <thead>
                    <tr>
                        <th>Manager</th>
                        <th>Team</th>
                        <th>Source</th>
                        <th>Gameweeks</th>
                        <th>Updated</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td class="name">@row.Name</td>
                            <td class="muted">@(row.Link?.TeamName ?? "–")</td>
                            <td>
                                @if (row.Link is { } link)
                                {
                                    <a href="@link.Url" target="_blank" rel="noopener">FPL #@link.EntryId</a>
                                }
                                else
                                {
                                    <span class="muted">CSV file</span>
                                }
                            </td>
                            <td>@row.Gameweeks</td>
                            <td>
                                @if (row.Link is { } l)
                                {
                                    @if (l.LastError is { } error)
                                    {
                                        <span class="error-text" title="@error">Update failed</span>
                                        <span class="sub">@error</span>
                                    }
                                    else
                                    {
                                        @Time(l.LastUpdated)
                                    }
                                }
                                else
                                {
                                    <span class="muted">When imported</span>
                                }
                            </td>
                            <td class="r">
                                @if (_confirmRemove == row.File)
                                {
                                    <button type="button" class="link-button danger" disabled="@_busy" @onclick="() => RemoveAsync(row)">Remove @row.Name</button>
                                    <button type="button" class="link-button" @onclick="() => _confirmRemove = null">Cancel</button>
                                }
                                else
                                {
                                    <button type="button" class="link-button" @onclick="() => _confirmRemove = row.File">Remove</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<p class="footnote">
    Links are remembered in <code>@System.IO.Path.Combine(Store.DataFolder, FplEntries.RegistryFileName)</code>,
    and each manager's history is kept as a CSV in the same folder, so the dashboard works even when FPL
    can't be reached.
</p>

@code {
    private sealed record Row(string Name, string File, FplEntries.LinkedManager? Link, string Gameweeks);

    private readonly CancellationTokenSource _cts = new();
    private List<FplEntries.Message> _messages = [];
    private List<Row> _rows = [];
    private string _input = "";
    private string? _confirmRemove;
    private bool _busy;

    private string Description => "Add managers by pasting their FPL links";

    protected override void OnInitialized()
    {
        Store.Changed += OnChanged;
        Entries.Changed += OnChanged;
        BuildRows();
    }

    private void OnChanged() => _ = InvokeAsync(() =>
    {
        BuildRows();
        StateHasChanged();
    });

    // Linked managers first (in the order they were added), then managers imported from CSV files.
    private void BuildRows()
    {
        var managers = Store.Current.Managers.ToDictionary(m => m.SourceFile, StringComparer.OrdinalIgnoreCase);
        var linked = Entries.Linked;
        var linkedFiles = linked.Select(l => l.File).ToHashSet(StringComparer.OrdinalIgnoreCase);

        _rows =
        [
            .. linked.Select(l =>
            {
                managers.TryGetValue(l.File, out var m);
                return new Row(m?.Name ?? l.PlayerName, l.File, l, Span(m));
            }),
            .. Store.Current.Managers
                .Where(m => !linkedFiles.Contains(m.SourceFile))
                .Select(m => new Row(m.Name, m.SourceFile, null, Span(m))),
        ];
    }

    private static string Span(ManagerHistory? manager)
    {
        if (manager is null || manager.Gameweeks.Count == 0)
        {
            return "–";
        }

        var first = manager.Gameweeks.Keys.Min();
        var last = manager.Gameweeks.Keys.Max();
        return first == last ? $"GW {first}" : $"GW {first}–{last}";
    }

    private async Task AddAsync()
    {
        if (string.IsNullOrWhiteSpace(_input))
        {
            return;
        }

        _busy = true;
        _messages = [];
        try
        {
            _messages = [.. await Entries.AddAsync(_input, _cts.Token)];
            if (!_messages.Any(m => m.IsError))
            {
                _input = "";
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveAsync(Row row)
    {
        _busy = true;
        try
        {
            if (row.Link is { } link)
            {
                await Entries.RemoveAsync(link.EntryId);
            }
            else
            {
                Store.Delete(row.File);
            }

            _messages = [new(false, $"Removed {row.Name}.")];
            _confirmRemove = null;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        const int maxFiles = 50;
        _messages = [];
        if (e.FileCount > maxFiles)
        {
            _messages.Add(new(true, $"Import at most {maxFiles} files at a time."));
            return;
        }

        var imported = new List<string>();
        foreach (var file in e.GetMultipleFiles(maxFiles))
        {
            // A linked manager's CSV is rewritten from FPL on every update, so don't let an import hide in it.
            if (Entries.Linked.Any(l => string.Equals(l.File, file.Name, StringComparison.OrdinalIgnoreCase)))
            {
                _messages.Add(new(true, $"{file.Name} belongs to a manager added by link. Rename the file to import it."));
                continue;
            }

            try
            {
                await using var stream = file.OpenReadStream(ManagerStore.MaxFileBytes, _cts.Token);
                var error = await Store.ImportAsync(file.Name, stream, _cts.Token);
                if (error is null)
                {
                    imported.Add(file.Name);
                }
                else
                {
                    _messages.Add(new(true, error));
                }
            }
            catch (IOException)
            {
                _messages.Add(new(true, $"{file.Name}: larger than 1 MB, not imported."));
            }
        }

        if (imported.Count > 0)
        {
            _messages.Insert(0, new(false, $"Imported {string.Join(", ", imported)}."));
        }
    }

    private static string Time(DateTimeOffset? time) =>
        time?.ToLocalTime().ToString("d MMM HH:mm", CultureInfo.InvariantCulture) ?? "–";

    public void Dispose()
    {
        Store.Changed -= OnChanged;
        Entries.Changed -= OnChanged;
        _cts.Cancel();
    }
}
