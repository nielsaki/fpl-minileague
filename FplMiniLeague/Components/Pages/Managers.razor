@page "/managers"
@using System.Globalization
@implements IDisposable
@inject ManagerStore Store
@inject FplFetcher Fetcher
@inject SiteMode Site

@* Local only: who is in the league according to teams.txt, and how the last fetch from FPL went.
   Teams are added and removed by editing teams.txt, not here. *@

<PageTitle>Managers · Mini-league</PageTitle>

<LeagueHeader Active="managers" Description="Teams come from teams.txt" />

@if (Fetcher.LastResult is { } result)
{
    @foreach (var error in result.Errors)
    {
        <p class="notice notice-error" role="status">@error</p>
    }
    @foreach (var warning in result.Warnings)
    {
        <p class="notice notice-warn" role="status">@warning</p>
    }
}
@foreach (var problem in Store.Current.Problems)
{
    <p class="notice notice-error">@problem</p>
}

<section class="panel">
    <header>
        <h3>In the league</h3>
        <span class="muted">@Store.Current.TeamIds.Count @(Store.Current.TeamIds.Count == 1 ? "team" : "teams")</span>
    </header>
    @if (Store.Current.TeamIds.Count == 0)
    {
        <p class="muted empty-line">No team IDs in teams.txt yet.</p>
    }
    else
    {
        <div class="table-scroll">
            <table class="plain managers">
                <thead>
                    <tr>
                        <th>Team ID</th>
                        <th>Manager</th>
                        <th>Team</th>
                        <th>Gameweeks</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var id in Store.Current.TeamIds)
                    {
                        var manager = Store.Current.Managers.FirstOrDefault(m => m.EntryId == id);
                        <tr>
                            <td>
                                <a href="@($"https://fantasy.premierleague.com/entry/{id}/history")" target="_blank" rel="noopener">@id</a>
                            </td>
                            @if (manager is null)
                            {
                                <td colspan="3" class="muted">Not fetched from FPL yet</td>
                            }
                            else
                            {
                                <td class="name">@manager.Name</td>
                                <td class="muted">@manager.TeamName</td>
                                <td>@Span(manager)</td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel">
    <header>
        <h3>Adding or removing a team</h3>
    </header>
    <p class="hint">
        Edit <code>@Store.TeamsFile</code>: one FPL team ID per line (the number in the team's FPL address,
        e.g. 2985395 in <code>fantasy.premierleague.com/entry/2985395/history</code>). Anything after
        <code>#</code> is a note. Saved here, the new team is fetched straight away; committed to GitHub,
        the published site updates within a few minutes.
    </p>
    <p class="hint">
        @if (Store.Current.Status?.UpdatedAt is { } updated)
        {
            @($"FPL data last changed {Site.FormatTime(updated)}. ")
        }
        It's saved in <code>@Store.Cache.Folder</code> and fetched again every
        @((int)FplRefresher.Interval.TotalMinutes) minutes while a gameweek is being played.
    </p>
</section>

@code {
    protected override void OnInitialized()
    {
        Store.Changed += OnChanged;
        Fetcher.Changed += OnChanged;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private static string Span(ManagerHistory manager)
    {
        if (manager.Gameweeks.Count == 0)
        {
            return "–";
        }

        var first = manager.Gameweeks.Keys.Min();
        var last = manager.Gameweeks.Keys.Max();
        return first == last
            ? $"GW {first.ToString(CultureInfo.InvariantCulture)}"
            : $"GW {first.ToString(CultureInfo.InvariantCulture)}–{last.ToString(CultureInfo.InvariantCulture)}";
    }

    public void Dispose()
    {
        Store.Changed -= OnChanged;
        Fetcher.Changed -= OnChanged;
    }
}
