@inject SiteMode Site

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="@Site.BasePath" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='9' fill='%2317375f'/%3E%3Cpath d='M7 22l6-7 5 4 7-9' fill='none' stroke='%23ffdf9d' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <link rel="stylesheet" href="css/theme.css" />
    @if (Site.IsStatic)
    {
        <HeadOutlet />
    }
    else
    {
        <HeadOutlet @rendermode="InteractiveServer" />
    }
</head>

<body>
    @* The published copy is plain HTML: no live connection, just a small script for the gameweek
       picker and the graph highlight. *@
    @if (Site.IsStatic)
    {
        <Routes />
        <script src="js/static.js"></script>
    }
    else
    {
        <Routes @rendermode="InteractiveServer" />
        <script src="_framework/blazor.web.js"></script>
    }
</body>

</html>
