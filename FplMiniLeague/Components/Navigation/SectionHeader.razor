@* The banner at the top of the page with its tabs under it — same markup and classes as
   SectionHeader in fss-platform/Urslit, so the two read as one product. *@
<header class="section-hero">
    <div class="section-hero-text">
        @if (!string.IsNullOrEmpty(Eyebrow))
        {
            <p class="section-eyebrow">@Eyebrow</p>
        }
        <h1>@Title</h1>
        @if (!string.IsNullOrEmpty(Description))
        {
            <p class="section-desc">@Description</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="section-actions">@Actions</div>
    }
</header>

@if (Tabs is { Count: > 1 })
{
    <nav class="section-tabs" aria-label="@Title">
        @foreach (var tab in Tabs)
        {
            var active = tab.Key == Active;
            <a href="@tab.Href" class="@(active ? "active" : null)" aria-current="@(active ? "page" : null)">@tab.Label</a>
        }
    </nav>
}

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";

    [Parameter] public string? Eyebrow { get; set; }

    [Parameter] public string? Description { get; set; }

    [Parameter] public IReadOnlyList<SectionTab>? Tabs { get; set; }

    /// <summary>Key of the tab this page is.</summary>
    [Parameter] public string? Active { get; set; }

    /// <summary>Buttons on the right of the banner.</summary>
    [Parameter] public RenderFragment? Actions { get; set; }
}
