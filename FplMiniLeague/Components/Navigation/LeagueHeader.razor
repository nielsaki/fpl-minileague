@implements IDisposable
@inject FplFetcher Fetcher
@inject ManagerStore Store
@inject SiteMode Site

@* The banner and tabs shared by every page. Locally it has the "Update from FPL" button and the
   Managers tab; the published copy has neither, and says when its data last changed instead. *@
<SectionHeader Eyebrow="Fantasy Premier League" Title="Mini-league" Description="@Description"
               Tabs="@Tabs" Active="@Active">
    <Actions>
        @if (Site.IsStatic)
        {
            @if (Store.Current.Status?.UpdatedAt is { } updated)
            {
                <span class="updated" title="When the FPL data last changed">Updated @Site.FormatTime(updated)</span>
            }
        }
        else if (Store.Current.TeamIds.Count > 0)
        {
            <button type="button" class="btn btn-light" disabled="@Fetcher.IsFetching" @onclick="UpdateAsync">
                @(Fetcher.IsFetching ? "Updating…" : "Update from FPL")
            </button>
        }
    </Actions>
</SectionHeader>

@code {
    /// <summary>Key of the current tab: season, gw, graphs, chips or managers.</summary>
    [Parameter, EditorRequired] public string Active { get; set; } = "";

    [Parameter] public string? Description { get; set; }

    /// <summary>Where the Gameweek tab goes: the chosen gameweek, or "gw" for the latest.</summary>
    [Parameter] public string GameweekHref { get; set; } = "gw";

    private IReadOnlyList<SectionTab> Tabs =>
    [
        new("season", "Season", ""),
        new("gw", "Gameweek", GameweekHref),
        new("graphs", "Graphs", "graphs"),
        new("chips", "Chips", "chips"),
        .. Site.IsStatic ? Array.Empty<SectionTab>() : [new("managers", "Managers", "managers")],
    ];

    protected override void OnInitialized() => Fetcher.Changed += OnFetcherChanged;

    private void OnFetcherChanged() => _ = InvokeAsync(StateHasChanged);

    private Task UpdateAsync() => Fetcher.FetchAsync(force: true);

    public void Dispose() => Fetcher.Changed -= OnFetcherChanged;
}
